  "components": {
    "securitySchemes": {
      "RxLab": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "GroupInput": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "instructions": {
            "default": "",
            "type": "string",
            "maxLength": 4000
          },
          "namingTemplate": {
            "default": "{date}-{title}",
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "schema": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          }
        },
        "required": [
          "name",
          "instructions",
          "namingTemplate",
          "schema"
        ],
        "additionalProperties": false
      },
      "Group": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "instructions": {
            "default": "",
            "type": "string",
            "maxLength": 4000
          },
          "namingTemplate": {
            "default": "{date}-{title}",
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "schema": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          },
          "id": {
            "type": "string"
          },
          "createdAt": {
            "type": "string"
          },
          "documentCount": {
            "type": "integer"
          }
        },
        "required": [
          "name",
          "instructions",
          "namingTemplate",
          "schema"
        ],
        "additionalProperties": false
      },
      "Document": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "groupId": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "originalName": {
            "type": "string"
          },
          "status": {
            "enum": [
              "uploaded",
              "processing",
              "ready",
              "failed"
            ]
          },
          "data": {
            "type": [
              "object",
              "null"
            ]
          },
          "error": {
            "type": [
              "string",
              "null"
            ]
          },
          "size": {
            "type": "integer"
          },
          "createdAt": {
            "type": "string"
          }
        }
      },
      "Proposal": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "state": {
            "type": "string"
          },
          "mutation": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "action": {
                    "type": "string",
                    "const": "create_group"
                  },
                  "group": {
                    "type": "object",
                    "properties": {
                      "name": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 100
                      },
                      "instructions": {
                        "default": "",
                        "type": "string",
                        "maxLength": 4000
                      },
                      "namingTemplate": {
                        "default": "{date}-{title}",
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200
                      },
                      "schema": {
                        "type": "object",
                        "propertyNames": {
                          "type": "string"
                        },
                        "additionalProperties": {}
                      }
                    },
                    "required": [
                      "name",
                      "instructions",
                      "namingTemplate",
                      "schema"
                    ],
                    "additionalProperties": false
                  }
                },
                "required": [
                  "action",
                  "group"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
