TURSO_DATABASE_URL=file:.data/scanner.db
TURSO_AUTH_TOKEN=
AUTH_ISSUER=https://auth.rxlab.app
RXLAB_ALLOWED_CLIENT_IDS=client_fe59446c23694e09bbe51111209f571a
# Optional outside Vercel; deployed functions use Vercel OIDC automatically.
# AI_GATEWAY_API_KEY=
AI_MODEL=openai/gpt-6-luna
# Private S3 or S3-compatible bucket. No public ACLs.
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Local PDF storage only for development; never set in production.
LOCAL_STORAGE_DIR=.data/pdfs

# Dedicated confidential RxAuth client; callback is {origin}/api/mcp/oauth/callback.
# Production resource: https://www.lumik.dev/api/mcp
MCP_RESOURCE_URL=http://localhost:3000/api/mcp
MCP_RXAUTH_CLIENT_ID=
MCP_RXAUTH_CLIENT_SECRET=
